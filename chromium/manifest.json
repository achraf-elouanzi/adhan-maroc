{
  "manifest_version": 3,
  "name": "Adhan Maroc",
  "version": "1.0.1",
  "description": "Horaires de prière au Maroc, rappels et Adhan — 100% local, sans serveur.",
  "author": "Adhan Maroc",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background-entry.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Adhan Maroc"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "offscreen"
  ],
  "optional_permissions": [
    "geolocation"
  ]
}
